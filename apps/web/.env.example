# 管理 API；缺省值为 http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# 公共播放地址的 origin；缺省从 VITE_API_URL 去掉末尾 /api 得到
VITE_PUBLIC_API_ORIGIN=http://localhost:8080

# 内联订阅序列化后的浏览器预检上限；不得高于 API 的 IPTV_INLINE_BODY_MAX_BYTES
VITE_INLINE_BODY_MAX_BYTES=16777216

# 仅用于本机显式预览；生产环境保持 false
VITE_DEMO_MODE=false

# 可选。会进入浏览器构建，只应在可信内网与 HTTPS 环境使用
VITE_ADMIN_TOKEN=
