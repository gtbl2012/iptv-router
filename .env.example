# API and storage
PORT=8080
DATABASE_URL=sqlite:./data/iptv-router.sqlite
IPTV_AUTO_MIGRATE=false
IPTV_PUBLIC_BASE_URL=http://localhost:8080
IPTV_CORS_ORIGINS=http://localhost:5173
# Set the same non-empty value in VITE_ADMIN_TOKEN outside local-only use.
IPTV_ADMIN_TOKEN=

# Subscription acquisition
IPTV_IMPORT_ROOT=./data/imports
IPTV_LOG_FILE=./data/logs/iptv-router.log
IPTV_IMPORT_MAX_BYTES=67108864
# Caps management JSON bodies independently from remote/file acquisition.
IPTV_INLINE_BODY_MAX_BYTES=16777216
IPTV_IMPORT_FETCH_TIMEOUT_MS=30000
# LAN multicast/private IPTV deployments may opt in explicitly.
IPTV_ALLOW_PRIVATE_NETWORKS=false

# Channel probes and source freshness
IPTV_SCHEDULER_ENABLED=true
IPTV_HEALTH_CRON=*/15 * * * *
IPTV_HEALTH_TIMEOUT_MS=10000
IPTV_HEALTH_CONCURRENCY=8
# Maximum number of ffmpeg video decoders running at once during health checks.
IPTV_MEDIA_VALIDATION_CONCURRENCY=2
IPTV_HEALTH_SAMPLE_BYTES=262144
# HTTP probes must decode one video frame; the same frame is stored only when previews are enabled.
IPTV_PREVIEW_ENABLED=true
IPTV_FFMPEG_PATH=ffmpeg
IPTV_PREVIEW_TIMEOUT_MS=8000
# Send SIGTERM first, then SIGKILL if ffmpeg is still alive after this grace period.
IPTV_FFMPEG_KILL_GRACE_MS=250
IPTV_PREVIEW_MAX_BYTES=524288
IPTV_HEALTH_STALE_AFTER_MS=3600000
IPTV_HEALTH_RETENTION_DAYS=30

# React Router server/client API access
VITE_API_URL=http://localhost:8080/api
VITE_PUBLIC_API_ORIGIN=http://localhost:8080
VITE_INLINE_BODY_MAX_BYTES=16777216
VITE_DEMO_MODE=false
VITE_ADMIN_TOKEN=
