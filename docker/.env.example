# Copy this file to the repository root as .env for the single-container Compose deployment.
# The browser management console uses this server-side password to mint an HttpOnly cookie.
IPTV_ADMIN_PASSWORD=replace-with-a-long-management-password
# Optional legacy Bearer credential for the oclif CLI and automation.
IPTV_ADMIN_TOKEN=
IPTV_AUTH_SESSION_TTL_MS=604800000
IPTV_AUTH_COOKIE_SECURE=false
DATABASE_URL=sqlite:/app/data/iptv-router.sqlite
IPTV_PUBLIC_BASE_URL=http://localhost:3000
IPTV_CORS_ORIGINS=http://localhost:3000

# Resource ceilings for the combined gateway/API/web container.
IPTV_APP_MEMORY_LIMIT=1g
IPTV_APP_CPU_LIMIT=2.0
IPTV_APP_PIDS_LIMIT=128
IPTV_APP_NOFILE_SOFT=4096
IPTV_APP_NOFILE_HARD=8192

# Persistent host directory for SQLite, previews, and runtime data.
# Leave unset to use the Docker-managed iptv-data volume instead.
IPTV_DATA_HOST_PATH=./data

# Read-only host directory for local playlist/import files.
IPTV_IMPORT_HOST_PATH=./data/imports

# Optional PostgreSQL overlay storage directory.
# POSTGRES_DATA_HOST_PATH=./data/postgres

# Same-origin browser build values used by the gateway.
VITE_API_URL=/api
VITE_PUBLIC_API_ORIGIN=
VITE_INLINE_BODY_MAX_BYTES=16777216
VITE_DEMO_MODE=false
